{
  "approved_resources": {
    "crm_entities": {
      "account": {
        "allowed_operations": [
          "read",
          "update_summary"
        ]
      },
      "case": {
        "allowed_operations": [
          "read"
        ]
      }
    },
    "sharepoint_sites": {
      "engineering_site": {
        "allowed_paths": [
          "/Shared Documents/Engineering",
          "/SitePages"
        ],
        "site_id": "engineering-site"
      },
      "hr_policy_site": {
        "allowed_paths": [
          "/Shared Documents/Policies",
          "/SitePages"
        ],
        "site_id": "hr-policy-site"
      }
    }
  },
  "discovery": {
    "semantic_search": {
      "allowed_subjects": [
        "claude-code-sharepoint-readers",
        "claude-code-sharepoint-publishers",
        "claude-code-crm-admins"
      ],
      "denied_subjects": [
        "people-assist-service"
      ],
      "enabled": true,
      "notes": [
        "Semantic search is for interactive Claude Code and developer use.",
        "Production service flows should use predefined tools.",
        "Search results must be filtered by authorization before model use."
      ],
      "tool_name": "x_amz_bedrock_agentcore_search"
    }
  },
  "identity": {
    "audience": "api://enterprise-mcp-nonprod",
    "claim_names": {
      "client_id_candidates": [
        "azp",
        "appid",
        "client_id"
      ],
      "groups": "groups",
      "roles": "roles",
      "scopes": "scp",
      "subject": "sub",
      "user_object_id": "oid"
    },
    "issuer": "https://login.microsoftonline.com/<tenant-id>/v2.0",
    "provider": "microsoft_entra_id",
    "required_scopes": [
      "mcp.invoke"
    ],
    "tenant_id": "<tenant-id>"
  },
  "metadata": {
    "default_decision": "deny",
    "description": "Human-maintained source of truth for Gateway JWT checks, semantic search discovery, MCP tool authorization, and runtime validation hints.\n",
    "name": "enterprise-mcp-tool-policy",
    "owner": "enterprise-ai-platform"
  },
  "subjects": {
    "claude-code-crm-admins": {
      "description": "Claude Code developers allowed to call selected CRM tools.",
      "entra": {
        "allowed_clients": [
          "claude-code-mcp-client-id"
        ],
        "required_groups_any": [
          "mcp-crm-admins"
        ],
        "required_roles_any": [
          "MCP.CRM.Admin"
        ],
        "required_scopes": [
          "mcp.invoke"
        ]
      },
      "type": "human_delegated"
    },
    "claude-code-sharepoint-publishers": {
      "description": "Claude Code developers allowed to write selected SharePoint content.",
      "entra": {
        "allowed_clients": [
          "claude-code-mcp-client-id"
        ],
        "required_groups_any": [
          "mcp-sharepoint-publishers"
        ],
        "required_roles_any": [
          "MCP.SharePoint.Publish"
        ],
        "required_scopes": [
          "mcp.invoke"
        ]
      },
      "type": "human_delegated"
    },
    "claude-code-sharepoint-readers": {
      "description": "Claude Code developers allowed to discover and read SharePoint tools.",
      "entra": {
        "allowed_clients": [
          "claude-code-mcp-client-id"
        ],
        "required_groups_any": [
          "mcp-sharepoint-readers"
        ],
        "required_roles_any": [
          "MCP.SharePoint.Read"
        ],
        "required_scopes": [
          "mcp.invoke"
        ]
      },
      "type": "human_delegated"
    },
    "people-assist-service": {
      "description": "People Assist Lambda service identity. Semantic search is denied.",
      "entra": {
        "allowed_clients": [
          "people-assist-client-id"
        ],
        "required_roles_any": [
          "MCP.PeopleAssist.SharePoint.Read"
        ],
        "required_scopes": [
          "mcp.invoke"
        ]
      },
      "type": "service_app"
    }
  },
  "test_cases": [
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-readers"
      },
      "expect": {
        "decision": "allow",
        "excludes": [
          "sharepoint_update_file_content",
          "crm_update_account_summary"
        ],
        "includes": [
          "sharepoint_list_site_content",
          "sharepoint_get_file_text"
        ]
      },
      "name": "SharePoint reader can discover only SharePoint read tools",
      "operation": "semantic_search",
      "query": "read HR policy from SharePoint"
    },
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-readers"
      },
      "expect": {
        "decision": "deny"
      },
      "input": {
        "account_id": "account-123",
        "audit_reason": "test denied CRM update",
        "change_ticket_id": "CHG-000001",
        "expected_row_version": "123",
        "idempotency_key": "crm-test-1",
        "summary": "new text"
      },
      "name": "SharePoint reader cannot call CRM update",
      "operation": "tool_call",
      "tool": "crm_update_account_summary"
    },
    {
      "caller": {
        "subject_ref": "people-assist-service"
      },
      "expect": {
        "decision": "deny"
      },
      "input": {
        "query": "find HR policy tools"
      },
      "name": "People Assist cannot use semantic search",
      "operation": "tool_call",
      "tool": "x_amz_bedrock_agentcore_search"
    },
    {
      "caller": {
        "subject_ref": "people-assist-service"
      },
      "expect": {
        "decision": "allow"
      },
      "input": {
        "drive_id": "drive-123",
        "item_id": "item-456",
        "site_id": "hr-policy-site"
      },
      "name": "People Assist can read approved SharePoint file",
      "operation": "tool_call",
      "tool": "sharepoint_get_file_text"
    },
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-readers"
      },
      "expect": {
        "decision": "allow"
      },
      "input": {
        "path": "/Shared Documents/Policies",
        "site_id": "hr-policy-site"
      },
      "name": "SharePoint reader can list approved path",
      "operation": "tool_call",
      "tool": "sharepoint_list_site_content"
    },
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-readers"
      },
      "expect": {
        "decision": "deny"
      },
      "input": {
        "path": "/",
        "site_id": "hr-policy-site"
      },
      "name": "SharePoint reader cannot list unapproved path",
      "operation": "tool_call",
      "tool": "sharepoint_list_site_content"
    },
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-publishers"
      },
      "expect": {
        "decision": "deny"
      },
      "input": {
        "audit_reason": "test denied SharePoint update",
        "change_ticket_id": "CHG-000002",
        "content": "updated",
        "drive_id": "drive-123",
        "expected_etag": "etag-123",
        "idempotency_key": "sp-test-2",
        "item_id": "item-456",
        "site_id": "unapproved-site"
      },
      "name": "Publisher cannot write outside approved site",
      "operation": "tool_call",
      "tool": "sharepoint_update_file_content"
    },
    {
      "caller": {
        "subject_ref": "claude-code-sharepoint-publishers"
      },
      "expect": {
        "decision": "deny"
      },
      "input": {
        "change_ticket_id": "CHG-000003",
        "content": "updated",
        "drive_id": "drive-123",
        "expected_etag": "etag-123",
        "idempotency_key": "sp-test-3",
        "item_id": "item-456",
        "site_id": "engineering-site"
      },
      "name": "Publisher write requires audit reason",
      "operation": "tool_call",
      "tool": "sharepoint_update_file_content"
    }
  ],
  "tools": {
    "crm_get_account": {
      "authorization": {
        "allowed_sites": [],
        "allowed_subjects": [
          "claude-code-crm-admins"
        ]
      },
      "description": "Read selected CRM account metadata.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "required": [
          "account_id"
        ]
      },
      "server": "crm-mcp",
      "write": false
    },
    "crm_update_account_summary": {
      "authorization": {
        "allowed_sites": [],
        "allowed_subjects": [
          "claude-code-crm-admins"
        ]
      },
      "description": "Update approved AI-generated summary field on a CRM account.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "required": [
          "account_id",
          "summary",
          "expected_row_version",
          "change_ticket_id",
          "idempotency_key",
          "audit_reason"
        ]
      },
      "server": "crm-mcp",
      "write": true,
      "write_controls": {
        "require_audit_reason": true,
        "require_change_ticket": true,
        "require_expected_row_version": true,
        "require_idempotency_key": true
      }
    },
    "sharepoint_get_file_text": {
      "audit": {
        "log_arguments": [
          "site_id",
          "drive_id",
          "item_id"
        ],
        "redact_arguments": [
          "file_text"
        ]
      },
      "authorization": {
        "allowed_sites": [
          "engineering_site",
          "hr_policy_site"
        ],
        "allowed_subjects": [
          "claude-code-sharepoint-readers",
          "claude-code-sharepoint-publishers",
          "people-assist-service"
        ]
      },
      "description": "Read text from one file in an approved SharePoint site.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "max_file_size_mb": 25,
        "required": [
          "site_id",
          "drive_id",
          "item_id"
        ]
      },
      "server": "sharepoint-mcp",
      "write": false
    },
    "sharepoint_insert_site_page_content": {
      "authorization": {
        "allowed_sites": [
          "engineering_site"
        ],
        "allowed_subjects": [
          "claude-code-sharepoint-publishers"
        ]
      },
      "description": "Insert approved content into a SharePoint site page.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "max_content_chars": 20000,
        "required": [
          "site_id",
          "page_title",
          "markdown_content",
          "change_ticket_id",
          "idempotency_key",
          "audit_reason"
        ]
      },
      "server": "sharepoint-mcp",
      "write": true,
      "write_controls": {
        "require_audit_reason": true,
        "require_change_ticket": true,
        "require_expected_etag": false,
        "require_idempotency_key": true
      }
    },
    "sharepoint_list_site_content": {
      "audit": {
        "log_arguments": [
          "site_id",
          "path"
        ],
        "redact_arguments": []
      },
      "authorization": {
        "allowed_sites": [
          "engineering_site",
          "hr_policy_site"
        ],
        "allowed_subjects": [
          "claude-code-sharepoint-readers",
          "claude-code-sharepoint-publishers",
          "people-assist-service"
        ]
      },
      "description": "List metadata under an approved SharePoint site/path.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "path_must_be_under_allowed_paths": true,
        "required": [
          "site_id",
          "path"
        ]
      },
      "server": "sharepoint-mcp",
      "write": false
    },
    "sharepoint_update_file_content": {
      "authorization": {
        "allowed_sites": [
          "engineering_site"
        ],
        "allowed_subjects": [
          "claude-code-sharepoint-publishers"
        ]
      },
      "description": "Modify one approved SharePoint file with optimistic concurrency.",
      "discovery": {
        "listable": true,
        "searchable": true
      },
      "input_constraints": {
        "required": [
          "site_id",
          "drive_id",
          "item_id",
          "expected_etag",
          "content",
          "change_ticket_id",
          "idempotency_key",
          "audit_reason"
        ]
      },
      "server": "sharepoint-mcp",
      "write": true,
      "write_controls": {
        "require_audit_reason": true,
        "require_change_ticket": true,
        "require_expected_etag": true,
        "require_idempotency_key": true
      }
    },
    "x_amz_bedrock_agentcore_search": {
      "authorization": {
        "allowed_sites": [],
        "allowed_subjects": [
          "claude-code-sharepoint-readers",
          "claude-code-sharepoint-publishers",
          "claude-code-crm-admins"
        ]
      },
      "description": "Built-in AgentCore Gateway semantic tool search.",
      "discovery": {
        "listable": false,
        "searchable": false
      },
      "server": "agentcore-gateway",
      "write": false
    }
  },
  "version": "2026-07-05"
}
