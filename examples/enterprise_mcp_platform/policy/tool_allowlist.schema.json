{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internal.example/schemas/enterprise-mcp-tool-allowlist.schema.json",
  "title": "Enterprise MCP Tool Allowlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "metadata",
    "identity",
    "subjects",
    "discovery",
    "approved_resources",
    "tools",
    "test_cases"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner", "default_decision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "default_decision": { "const": "deny" },
        "description": { "type": "string" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "tenant_id", "issuer", "audience", "required_scopes", "claim_names"],
      "properties": {
        "provider": { "const": "microsoft_entra_id" },
        "tenant_id": { "type": "string", "minLength": 1 },
        "issuer": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "required_scopes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "claim_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject", "user_object_id", "client_id_candidates", "scopes", "roles", "groups"],
          "properties": {
            "subject": { "type": "string", "minLength": 1 },
            "user_object_id": { "type": "string", "minLength": 1 },
            "client_id_candidates": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "scopes": { "type": "string", "minLength": 1 },
            "roles": { "type": "string", "minLength": 1 },
            "groups": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/subject" }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_search"],
      "properties": {
        "semantic_search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "enabled", "allowed_subjects"],
          "properties": {
            "tool_name": { "type": "string", "minLength": 1 },
            "enabled": { "type": "boolean" },
            "allowed_subjects": { "$ref": "#/$defs/string_list" },
            "denied_subjects": { "$ref": "#/$defs/string_list" },
            "notes": { "$ref": "#/$defs/string_list" }
          }
        }
      }
    },
    "approved_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sharepoint_sites", "crm_entities"],
      "properties": {
        "sharepoint_sites": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sharepoint_site" }
        },
        "crm_entities": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/crm_entity" }
        }
      }
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/tool" }
    },
    "test_cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/test_case" }
    }
  },
  "$defs": {
    "string_list": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description", "entra"],
      "properties": {
        "type": { "enum": ["human_delegated", "service_app"] },
        "description": { "type": "string", "minLength": 1 },
        "entra": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_clients"],
          "properties": {
            "allowed_clients": { "$ref": "#/$defs/string_list" },
            "required_scopes": { "$ref": "#/$defs/string_list" },
            "required_roles_any": { "$ref": "#/$defs/string_list" },
            "required_groups_any": { "$ref": "#/$defs/string_list" }
          }
        }
      }
    },
    "sharepoint_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "allowed_paths"],
      "properties": {
        "site_id": { "type": "string", "minLength": 1 },
        "allowed_paths": { "$ref": "#/$defs/string_list" }
      }
    },
    "crm_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_operations"],
      "properties": {
        "allowed_operations": { "$ref": "#/$defs/string_list" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server", "description", "discovery", "authorization", "write"],
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["searchable", "listable"],
          "properties": {
            "searchable": { "type": "boolean" },
            "listable": { "type": "boolean" }
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_subjects"],
          "properties": {
            "allowed_subjects": { "$ref": "#/$defs/string_list" },
            "allowed_sites": { "$ref": "#/$defs/string_list" }
          }
        },
        "input_constraints": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "required": { "$ref": "#/$defs/string_list" }
          }
        },
        "write": { "type": "boolean" },
        "write_controls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_change_ticket": { "type": "boolean" },
            "require_idempotency_key": { "type": "boolean" },
            "require_expected_etag": { "type": "boolean" },
            "require_expected_row_version": { "type": "boolean" },
            "require_audit_reason": { "type": "boolean" }
          }
        },
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "log_arguments": { "$ref": "#/$defs/string_list" },
            "redact_arguments": { "$ref": "#/$defs/string_list" }
          }
        }
      }
    },
    "test_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "caller", "operation", "expect"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "caller": {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_ref"],
          "properties": {
            "subject_ref": { "type": "string", "minLength": 1 }
          }
        },
        "operation": { "enum": ["semantic_search", "tool_call"] },
        "query": { "type": "string" },
        "tool": { "type": "string" },
        "input": {
          "type": "object",
          "additionalProperties": true
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision"],
          "properties": {
            "decision": { "enum": ["allow", "deny"] },
            "includes": { "$ref": "#/$defs/string_list" },
            "excludes": { "$ref": "#/$defs/string_list" }
          }
        }
      }
    }
  }
}
