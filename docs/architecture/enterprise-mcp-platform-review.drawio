        <mxCell id="page_title" value="Migration Roadmap and Approval Gates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;fontSize=24;fontStyle=1;align=left;strokeOpacity=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="930" height="42" as="geometry" />
        </mxCell>
        <mxCell id="page_subtitle" value="Progression from PoC evidence to production; SharePoint data remains in place" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;fontSize=13;align=left;fontColor=#526579;strokeOpacity=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="62" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0&lt;br&gt;Approve architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate A: owners, classification&lt;br&gt;and risk conditions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1&lt;br&gt;Complete implementation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Graph upload, claims, Cedar,&lt;br&gt;and supply chain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2&lt;br&gt;Deploy nonprod&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate B: real identity, network&lt;br&gt;and Runtime path pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3&lt;br&gt;Read-only pilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate C: named cohort, token flow&lt;br&gt;and policy ENFORCE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
