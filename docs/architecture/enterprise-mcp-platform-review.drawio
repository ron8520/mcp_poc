        <mxCell id="p5" value="&lt;b&gt;Phase 5&lt;br&gt;Controlled upload pilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate D: one site/path and&lt;br&gt;invalid-input rejection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
