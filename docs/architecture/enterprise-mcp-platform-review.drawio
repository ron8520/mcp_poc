          <mxGeometry x="35" y="20" width="930" height="42" as="geometry" />
        </mxCell>
        <mxCell id="page_subtitle" value="Caller identity, AWS workload authorization and downstream Graph identity remain separate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;fontSize=13;align=left;fontColor=#526579;strokeOpacity=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="62" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="flow_caller" value="&lt;b&gt;1. Approved caller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Managed device or AWS AI workload&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6F42C1;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_entra" value="&lt;b&gt;2. Microsoft Entra&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Authenticates caller and issues Token A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#F1ECFA;strokeColor=#6F42C1;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_request" value="&lt;b&gt;3. Caller sends MCP request&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;HTTPS + Bearer Token A to Gateway&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6F42C1;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="340" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_jwt" value="&lt;b&gt;4. Gateway JWT validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Issuer, audience, client and scope/claims&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#EAF2F8;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="460" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_policy" value="&lt;b&gt;5. Gateway Policy&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Deterministic tool and input authorization&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#EAF2F8;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="580" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_invoke" value="&lt;b&gt;6. Gateway invokes Runtime target&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;SigV4 using the Gateway service role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#EAF2F8;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="700" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_runtime" value="&lt;b&gt;7. Runtime validation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Schema, site, path and write controls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#EAF2F8;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="820" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="flow_graph" value="&lt;b&gt;8. Microsoft Graph / SharePoint&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Graph API call + Token B; selected permission&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFF3E0;strokeColor=#C56A00;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="940" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="token_a" value="&lt;b&gt;Credential boundary A&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Enterprise MCP API token&lt;br&gt;returned to caller&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6F42C1;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="235" width="235" height="105" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="&lt;b&gt;Fail closed&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Invalid token, denied policy&lt;br&gt;or invalid Runtime input&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FDEDEC;strokeColor=#B42318;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="35" y="480" width="235" height="180" as="geometry" />
        </mxCell>
        <mxCell id="iam_boundary" value="&lt;b&gt;AWS IAM boundary&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gateway service role signs call&lt;br&gt;Runtime role remains separate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="685" width="235" height="110" as="geometry" />
        </mxCell>
        <mxCell id="token_b" value="&lt;b&gt;Credential boundary B&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Runtime obtains Graph token&lt;br&gt;never reuse Token A&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#C56A00;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="730" y="930" width="235" height="110" as="geometry" />
        </mxCell>
        <mxCell id="audit" value="&lt;b&gt;Audit metadata&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Decision + result metadata&lt;br&gt;No secrets or documents&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#EAF6EC;strokeColor=#2E7D32;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
