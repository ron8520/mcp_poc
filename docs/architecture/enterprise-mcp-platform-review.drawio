        <mxCell id="flow_caller" value="&lt;b&gt;1. Approved caller&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Delegated user or application identity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#6F42C1;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
