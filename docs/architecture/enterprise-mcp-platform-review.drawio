  <diagram id="migration-roadmap" name="Migration Roadmap">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="page_title" value="Migration Roadmap and Approval Gates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;fontSize=24;fontStyle=1;align=left;strokeOpacity=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="930" height="42" as="geometry" />
        </mxCell>
        <mxCell id="page_subtitle" value="Progression from PoC evidence to production; SharePoint data remains in place" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;fontSize=13;align=left;fontColor=#526579;strokeOpacity=0;" vertex="1" parent="1">
          <mxGeometry x="35" y="62" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;Phase 0&lt;br&gt;Approve architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate A: owners, classification&lt;br&gt;and risk conditions&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="&lt;b&gt;Phase 1&lt;br&gt;Complete implementation&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Graph, claims, Cedar,&lt;br&gt;idempotency, supply chain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="140" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;Phase 2&lt;br&gt;Deploy nonprod&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate B: real identity, network&lt;br&gt;and Runtime path pass&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="390" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;Phase 3&lt;br&gt;Read-only pilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate C: named cohort, token flow&lt;br&gt;and policy ENFORCE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="390" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;Phase 4&lt;br&gt;AWS AI caller read&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Optional app-only&lt;br&gt;agent or application&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#F5F7FA;strokeColor=#7890A8;fontColor=#17324D;strokeWidth=2;dashed=1;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="640" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;Phase 5&lt;br&gt;Controlled write pilot&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Gate D: one site/path, ticket,&lt;br&gt;idempotency and ETag&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="400" height="170" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="&lt;b&gt;Phase 6&lt;br&gt;Production rollout&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Separate production state;&lt;br&gt;gradual enablement + rollback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#2E74B5;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="920" width="400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="prod_gate" value="&lt;b&gt;Production approval gate&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Evidence accepted by accountable owners&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FDEDEC;strokeColor=#B42318;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="335" y="840" width="330" height="55" as="geometry" />
        </mxCell>
        <mxCell id="deferred" value="&lt;b&gt;Production approval remains deferred&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#526579&quot;&gt;Nonprod approval does not enable writes, broad cohorts or future targets&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;align=center;verticalAlign=middle;fillColor=#FDEDEC;strokeColor=#B42318;fontColor=#17324D;strokeWidth=2;dashed=0;fontSize=13;spacing=8;" vertex="1" parent="1">
